# --- Contact form (Resend) ---
# Create an API key at https://resend.com — you already use Resend for the TAC CRM.
# Verify the petrichor-consult.com domain in Resend so mail sends from your own domain.
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_FROM="Petrichor Website <website@petrichor-consult.com>"
CONTACT_TO=louwrens@petrichor-consult.com

# --- Google reviews carousel ---
# 1. Create/claim your Google Business Profile (https://business.google.com)
# 2. In Google Cloud Console: enable "Places API (New)", create an API key,
#    restrict it to the Places API. This key is only used server-side.
# 3. Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
